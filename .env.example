# Template only. Copy to .env and set local values; never commit secrets.
# .env is loaded without overriding existing process environment variables.
FLASK_DEBUG=0
SECRET_KEY=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aidc_workload_matcher
MYSQL_USER=
MYSQL_PASSWORD=

# Dedicated, pre-created integration-test DB. No development fallback.
# Must end in _test and differ from MYSQL_DATABASE.
TEST_MYSQL_HOST=
TEST_MYSQL_PORT=
TEST_MYSQL_DATABASE=
TEST_MYSQL_USER=
TEST_MYSQL_PASSWORD=

# Local Flask UI: read-only by default; no automatic migrations or seed inserts.
# Writes also require an exact verified v0.3-2 schema and a non-test MYSQL_* DB.
WEB_ENABLE_WRITES=0
WEB_WRITE_DATABASE=
# Optional persistent session key. Blank means a random key on every startup.
WEB_SECRET_KEY=
