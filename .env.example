# Template only. Copy to .env and set local values; never commit secrets.
# .env is loaded without overriding existing process environment variables.
FLASK_DEBUG=0
SECRET_KEY=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aidc_workload_matcher
MYSQL_USER=
MYSQL_PASSWORD=

# Dedicated, pre-created integration-test DB. No development fallback.
# Must end in _test and differ from MYSQL_DATABASE.
TEST_MYSQL_HOST=
TEST_MYSQL_PORT=
TEST_MYSQL_DATABASE=
TEST_MYSQL_USER=
TEST_MYSQL_PASSWORD=
